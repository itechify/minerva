{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minerva",
  "version": "0.12.0",
  "identifier": "com.itechify.minerva",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Minerva",
        "url": "index.html",
        "width": 380,
        "height": 72,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "focusable": false,
        "contentProtected": false
      },
      {
        "label": "grind-tracker",
        "title": "Grind Tracker",
        "url": "grind-tracker.html",
        "width": 280,
        "height": 140,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "contentProtected": false
      },
      {
        "label": "personal-bests",
        "title": "Personal Bests",
        "url": "personal-bests.html",
        "width": 920,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "contentProtected": false
      },
      {
        "label": "item-lookup",
        "title": "Item Lookup",
        "url": "item-lookup.html",
        "width": 440,
        "height": 40,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "contentProtected": false
      },
      {
        "label": "item-card",
        "title": "Item Card",
        "url": "item-card.html",
        "width": 280,
        "height": 160,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "contentProtected": false
      },
      {
        "label": "deal-badges",
        "title": "Deal Badges",
        "url": "deal-badges.html",
        "width": 116,
        "height": 360,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "contentProtected": false
      },
      {
        "label": "setup",
        "title": "Minerva Setup",
        "url": "setup.html",
        "width": 520,
        "height": 560,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "visible": false
      },
      {
        "label": "region",
        "title": "Mark the minimap title",
        "url": "region.html",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "contentProtected": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "MIT",
    "copyright": "Copyright © 2026 Jeffrey Davis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
