{
  "name": "minerva",
  "private": true,
  "license": "MIT",
  "version": "0.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "tsc && vite build --config site/vite.config.ts",
    "site:local": "node scripts/site-local.mjs",
    "site:test": "tsc -p site/worker && vitest run --config site/worker/vitest.config.ts && vitest run --config site/leaderboards/vitest.config.ts && vitest run --config site/account/vitest.config.ts && vitest run --config site/character/vitest.config.ts",
    "shot": "node scripts/shot.mjs",
    "preview:window": "node scripts/preview-window.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@tauri-apps/cli": "^2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "~4.1.11",
    "wrangler": "^4.150.0"
  }
}
